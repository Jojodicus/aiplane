# Human in the loop (#96): what the gateway itself says when a conversation
# waits for a person.

# A website visitor reads this when nobody from the owner's team answered a
# handoff in time.
agent-human-no-answer = Nobody from our team could answer in time. Please try again later or use the website's other contact options.

# Notifications (Web Push, Slack, Discord) when a turn starts waiting.
agent-inbox-notify-title = { $agent } is waiting for you
agent-inbox-notify-approval = An action needs your approval.
agent-inbox-notify-handoff = A visitor needs an answer from a person.
agent-inbox-notify-run-title = A run is waiting for you
agent-inbox-notify-run = Your run is waiting for a decision.
agent-inbox-notify-open = Open the inbox
